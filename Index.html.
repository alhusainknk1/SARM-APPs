<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SARM - School Attendance & Records Manager</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
}

header {
    background: #087443;
    color: white;
    padding: 20px;
    text-align: center;
}

.container {
    max-width: 900px;
    margin: 25px auto;
    padding: 20px;
}

.card {
    background: white;
    padding: 20px;
    margin: 15px 0;
    border-radius: 12px;
    box-shadow: 0 2px 8px #ddd;
}

button {
    background: #087443;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    cursor: pointer;
}

input {
    width: 90%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
}

h2 { color: #087443; }

footer {
    text-align: center;
    padding: 20px;
    color: #666;
}
</style>
</head>

<body>

<header>
    <h1>SARM</h1>
    <p>School Attendance & Records Manager</p>
</header>

<div class="container">

<div class="card">
    <h2>Welcome to SARM</h2>
    <p>Manage Schools, Teachers, Students and Attendance Records.</p>
</div>

<div class="card">
    <h2>Admin Login</h2>
    <input type="text" placeholder="Admin Username">
    <input type="password" placeholder="Admin Password">
    <button>Login as Admin</button>
</div>

<div class="card">
    <h2>Staff Login</h2>
    <input type="text" placeholder="Staff ID">
    <input type="password" placeholder="Staff PIN">
    <button>Login as Staff</button>
</div>

</div>

<footer>
    SARM Web App V1.0
</footer>

</body>
</html>
